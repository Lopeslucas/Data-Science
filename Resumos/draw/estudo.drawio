            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="2" value="&lt;h1&gt;Machine Learning&lt;/h1&gt;" style="text;strokeColor=none;fillColor=none;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="30" y="10" width="380" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="3" value="Aprendizado Supervisionado" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="330" width="180" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="4" value="Aprendizado Não Supervisionado" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="230" y="330" width="190" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="7" value="Aprendizado Por Reforço" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="710" y="330" width="160" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="9" value="Aprendizado Semi-&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;Supervisionado&lt;/span&gt;" style="whiteSpace=wrap;html=1;rounded=1;" parent="1" vertex="1">
                    <mxGeometry x="470" y="330" width="200" height="60" as="geometry"/>
                </mxCell>
                <mxCell id="10" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;É uma subárea da inteligência artificial que se concentra no desenvolvimento de algoritimos e modelos que permitem aos computadores aprender e&amp;nbsp; melhorar a partir de experiencias passadas.&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-weight: 400;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&quot;Campo de estudo que permite aos computadores a capacidade de aprender sem serem explicitamente programados&quot; - Arthur Samuel, 1959&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;align=left;" parent="1" vertex="1">
                    <mxGeometry x="20" y="80" width="870" height="140" as="geometry"/>
                </mxCell>
                <mxCell id="11" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;Tipos de Aprendizado de Maquina&lt;/font&gt;&lt;/h2&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="20" y="270" width="860" height="50" as="geometry"/>
                </mxCell>
                <mxCell id="14" value="São utilizados em tarefas onde se tem um conjunto de dados rotulados, ou seja, onde cada entrada é acompanhado de uma saída conhecida.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Objetivo desse algoritimo é aprender uma função que mapei as entradas para as saídas, permitindo que o modelo faça previsões sobre novos dados não rotulados.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="20" y="410" width="160" height="200" as="geometry"/>
                </mxCell>
                <mxCell id="15" value="Parte dos dados Rotulados" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="470" y="410" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="16" value="Não possuem dados rotulados.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Os algoritimos não-supervisionados buscam identificar padrões e entrutuas ocultas nos dados sem a ncessidade de supervisão externa&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="230" y="410" width="160" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="17" value="Baseado em recompensas e penalidades" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="710" y="410" width="160" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="19" value="" style="line;strokeWidth=2;html=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="250" width="860" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="20" value="" style="line;strokeWidth=2;direction=south;html=1;" parent="1" vertex="1">
                    <mxGeometry x="920" y="-240" width="10" height="3140" as="geometry"/>
                </mxCell>
                <mxCell id="21" value="&lt;h2&gt;&lt;font style=&quot;font-size: 17px;&quot;&gt;Temos os tipos de problemas de ML:&lt;/font&gt;&lt;/h2&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Classificação (saída categórica)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Regressão (saída númerica)&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Agrupamento&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="20" y="630" width="510" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Classificação: &lt;/b&gt;São algoritimos utilizados com o objetivo prever categorias ou classes. O modelo tenta atribuir rotilos a entradas com base em dados de treinamento.&amp;nbsp;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;Exemplo&lt;/span&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;:&amp;nbsp;&lt;/span&gt;&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Classificar e-mails como &quot;spam/ não spam&quot;.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;identificar se uma imagem contém um gato ou um cachorro.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Prever se um cliente irá comprar um produto.&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Regressão: &lt;/b&gt;São algoritimos utilizados com o objetivo de prever um valor contínuo. O modelo tenta prever uma quantidade numérica com base em dados de entrada. Exemplo:&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Prever o preço de uma casa com base em características, como tamanho e localização.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Estimar a temperatura de uma cidade em um determinado dia.&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Agrupamento: &lt;/b&gt;São algoritimos que não possuem rôtulos, e o modelo tenta encontrar padrões por conta própria. Exemplo:&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Segmentação de clientes&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
                    <mxGeometry x="20" y="740" width="860" height="320" as="geometry"/>
                </mxCell>
                <mxCell id="29" value="" style="line;strokeWidth=2;html=1;" parent="1" vertex="1">
                    <mxGeometry x="20" y="1080" width="860" height="10" as="geometry"/>
                </mxCell>
                <mxCell id="35" value="Tipos de Variáveis" style="text;strokeColor=none;fillColor=none;html=1;fontSize=44;fontStyle=1;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="20" y="1120" width="395" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="36" value="&lt;b&gt;Númericas&lt;/b&gt;:&lt;div&gt;&lt;ul&gt;&lt;li&gt;&lt;font&gt;Contínuas:&amp;nbsp;&lt;span style=&quot;color: rgb(10, 10, 10); font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif;&quot;&gt;Assume qualquer valor dentro de um intervalo específico, permitindo precisão decimal.&lt;/span&gt;&amp;nbsp;- ex: Idade, Peso&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font&gt;Discretas:&amp;nbsp;&lt;span style=&quot;color: rgb(63, 63, 63);&quot;&gt;&lt;span style=&quot;color: rgb(10, 10, 10); font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif;&quot;&gt;Assume valores distintos, geralmente inteiros, que podem ser contados.&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;ex:&amp;nbsp;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent;&quot;&gt;Número de filhos&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;font&gt;&lt;span style=&quot;color: rgb(10, 10, 10); font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif;&quot;&gt;A principal diferença é que variáveis discretas são&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: bolder; color: rgb(10, 10, 10); font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif;&quot; data-processed=&quot;true&quot; class=&quot;Yjhzub&quot;&gt;contadas&lt;/span&gt;&lt;span style=&quot;color: rgb(10, 10, 10); font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif;&quot;&gt;&amp;nbsp;(inteiros), enquanto variáveis contínuas são&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;font-weight: bolder; color: rgb(10, 10, 10); font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif;&quot; data-processed=&quot;true&quot; class=&quot;Yjhzub&quot;&gt;medidas&lt;/span&gt;&lt;span style=&quot;color: rgb(10, 10, 10); font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif;&quot;&gt;&amp;nbsp;(números reais).&lt;/span&gt;&lt;span style=&quot;color: rgb(10, 10, 10); font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif;&quot; data-processed=&quot;true&quot; data-wiz-uids=&quot;k3Vdgf_5v,k3Vdgf_5w&quot; class=&quot;uJ19be notranslate&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap; position: relative;&quot; data-processed=&quot;true&quot; data-wiz-attrbind=&quot;class=k3Vdgf_5u/TKHnVd&quot; data-animation-atomic=&quot;&quot; class=&quot;vKEkVd&quot;&gt;&lt;span data-processed=&quot;true&quot; aria-hidden=&quot;true&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;b&gt;&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Categóricas:&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Nominais (sem ordem) - ex: Cor, País&lt;/li&gt;&lt;li&gt;Ordinais (com ordem) - ex: Nível de Satisfação&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Booleanas&lt;/b&gt;:&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Binárias - ex: 0/1, sim/não&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;Temporais:&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Datas, horários, sazonalidades&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=22;" parent="1" vertex="1">
                    <mxGeometry x="20" y="1180" width="860" height="600" as="geometry"/>
                </mxCell>
                <mxCell id="37" value="&lt;h1&gt;Tratamento de Dados&lt;/h1&gt;" style="text;strokeColor=none;fillColor=none;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=center;" parent="1" vertex="1">
                    <mxGeometry x="7830" y="1070" width="500" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="38" value="O tratamento de dados é uma etapa crítica que prepara os dados brutos para que os algoritimos de ML consigam aprender com eficiência e produzir bons resultados.&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;É um processo que envolve a &lt;b&gt;limpeza, transformação e preparação dos dados&lt;/b&gt; antes de alimentar um modelo de ML.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Por que o tratamento de dados é necessario?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Dados brutos geralmente podem têr, erros humanos, informações faltantes, duplicadas, formatos incompatíveis. E se forem usados sem tratamento, os modelos:&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Aprender padrões errados&lt;/li&gt;&lt;li&gt;Ter baixa acurácia&lt;/li&gt;&lt;li&gt;Serem enviesados ou instáveis&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;b&gt;&lt;br&gt;&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;Quais os benefícios em tratar os dados?&lt;/b&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;ul&gt;&lt;li&gt;Dados limpos reduzem o ruído e melhora o desempenho&lt;/li&gt;&lt;li&gt;Variáveis no mesmo padrão&lt;/li&gt;&lt;li&gt;Codificação adequada, permitindo o uso de variáveis categóricas&lt;/li&gt;&lt;li&gt;Menos Outliers, evitando que os &quot;extremos&quot;, distorçam o aprendizado&lt;/li&gt;&lt;li&gt;Dados mais concisos, fazendo com que os modelos aprendam &quot;melhor&quot;&lt;/li&gt;&lt;/ul&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;*O tratamento dos dados é uma parte fundamental da etapa de pré-processamento&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="7830" y="1140" width="1030" height="480" as="geometry"/>
                </mxCell>
                <mxCell id="39" value="" style="line;strokeWidth=2;direction=south;html=1;" parent="1" vertex="1">
                    <mxGeometry x="2040" y="10" width="10" height="2520" as="geometry"/>
                </mxCell>
                <mxCell id="40" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" parent="1" vertex="1">
                    <mxGeometry x="-1000" width="912.5" height="730" as="geometry"/>
                </mxCell>
                <mxCell id="51" value="" style="shape=image;imageAspect=0;aspect=fixed;verticalLabelPosition=bottom;verticalAlign=top;image=data:image/jpeg,;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="150" width="796.77" height="570" as="geometry"/>
                </mxCell>
                <mxCell id="52" value="&lt;ul&gt;&lt;li&gt;&lt;b&gt;Moda&lt;/b&gt;: Pode ser usada em dados discretos (categoricos).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Mediana&lt;/b&gt;: Para variaveis numericas quando possuem outliers ou distribuição assimetrica (não é afetada por extremos).&lt;/li&gt;&lt;li&gt;&lt;b&gt;Média Ponderada:&lt;/b&gt; Quando cada valor tem uma importancia/ peso diferentes.&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=22;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="740" width="890" height="150" as="geometry"/>
                </mxCell>
                <mxCell id="53" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;Tratamento de Variáveis Categóricas (Encoding)&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;Label Encoding:&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;Técnica de pré-processamento de dados que transforma variáveis categóricas (como texto) em valores numéricos inteiros, atribuindo um número único para cada categoria distinta. Essa conversão é necessária porque muitos algoritmos de aprendizado de máquina não conseguem trabalhar diretamente com dados de texto.&lt;/p&gt;&lt;div style=&quot;color: rgb(10, 10, 10);&quot; class=&quot;WaaZC&quot;&gt;&lt;div style=&quot;color: rgb(10, 10, 10); animation: auto ease 0s 1 normal none running none !important;&quot; class=&quot;RJPOee EIJn2&quot;&gt;&lt;div style=&quot;margin: 20px 0px 10px; font-weight: 600; line-height: 28px;&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQo_EKegQIDRAB&quot; data-hveid=&quot;CA0QAQ&quot; class=&quot;rPeykc uP58nb rWIipd&quot;&gt;&lt;span style=&quot;&quot; data-huuid=&quot;7341921977374771736&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Como funciona&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10);&quot; class=&quot;WaaZC&quot;&gt;&lt;div style=&quot;color: rgb(10, 10, 10); animation: auto ease 0s 1 normal none running none !important;&quot; class=&quot;RJPOee EIJn2&quot;&gt;&lt;ul style=&quot;margin: 10px 0px 20px; padding: 0px; line-height: 24px; padding-inline-start: 16px;&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQm_YKegQIHRAB&quot; data-hveid=&quot;CB0QAQ&quot;&gt;&lt;li style=&quot;margin: 0px 0px 8px; padding-top: 0px; padding-bottom: 0px; padding-inline-start: 4px; list-style: inherit;&quot;&gt;&lt;div style=&quot;padding-bottom: 0px; padding-top: 0px; border-bottom: none;&quot; data-il=&quot;&quot; class=&quot;zMgcWd dSKvsb&quot;&gt;&lt;div data-crb-p=&quot;&quot;&gt;&lt;div style=&quot;flex: 1 1 0%; min-width: 0px;&quot; class=&quot;xFTqob&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;div style=&quot;line-height: 24px; overflow: hidden; padding-bottom: 4px; transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); display: inline;&quot; class=&quot;Gur8Ad&quot;&gt;&lt;span data-huuid=&quot;7341921977374770077&quot;&gt;&lt;strong&gt;Atribuição de números:&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10); line-height: 24px; display: inline;&quot; class=&quot;vM0jzc&quot;&gt;&lt;span data-huuid=&quot;7341921977374769524&quot;&gt;Cada categoria única em uma variável categórica é mapeada para um número inteiro.&lt;span data-cid=&quot;c77a88a6-adfa-4b9d-97c6-083e02cec350&quot; class=&quot;pjBG2e&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot; class=&quot;UV3uM&quot;&gt;&amp;nbsp;&lt;div style=&quot;margin-inline-end: 6px; vertical-align: middle; display: inline-flex;&quot; data-uuids=&quot;7341921977374770077,7341921977374769524&quot; data-cid=&quot;c77a88a6-adfa-4b9d-97c6-083e02cec350&quot; class=&quot;NPrrbc&quot;&gt;&lt;div style=&quot;display: inline-block; vertical-align: middle; cursor: pointer; outline: 0px; -webkit-tap-highlight-color: transparent; color: rgb(11, 87, 208);&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQ3fYKegQIEhAB&quot; data-hveid=&quot;CBIQAQ&quot; tabindex=&quot;0&quot; role=&quot;button&quot; aria-label=&quot;Mostrar links relacionados&quot; class=&quot;BMebGe btku5b LwdV0e FR7ZSc OJeuxf&quot;&gt;&lt;div style=&quot;display: flex; justify-content: center; position: relative; align-items: center; width: 28px; z-index: 0; box-sizing: border-box; border-radius: 9999px; padding: 0px; background: transparent; outline: transparent solid 1px; outline-offset: -1px; height: 20px; margin: 0px auto; min-height: 20px;&quot; class=&quot;niO4u&quot;&gt;&lt;span style=&quot;flex-shrink: 0; display: flex; align-items: center; height: 20px; color: rgb(31, 31, 31); background: unset !important;&quot; class=&quot;d3o3Ad Hkv2Pe&quot;&gt;&lt;span style=&quot;display: flex; height: unset; rotate: 135deg;&quot; class=&quot;iPjmzb Sorfoc gNGSDf&quot;&gt;&lt;span style=&quot;display: inline-block; fill: currentcolor; height: 18px; line-height: 18px; position: relative; width: 18px;&quot; class=&quot;z1asCe Sb7k4e&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;li style=&quot;margin: 0px 0px 8px; padding-top: 0px; padding-bottom: 0px; padding-inline-start: 4px; list-style: inherit;&quot;&gt;&lt;div style=&quot;padding-bottom: 0px; padding-top: 8px; border-bottom: none;&quot; data-il=&quot;&quot; class=&quot;zMgcWd dSKvsb&quot;&gt;&lt;div data-crb-p=&quot;&quot;&gt;&lt;div style=&quot;flex: 1 1 0%; min-width: 0px;&quot; class=&quot;xFTqob&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;div style=&quot;line-height: 24px; overflow: hidden; padding-bottom: 4px; transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); display: inline;&quot; class=&quot;Gur8Ad&quot;&gt;&lt;span data-huuid=&quot;7341921977374772514&quot;&gt;&lt;strong&gt;Exemplo:&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10); line-height: 24px; display: inline;&quot; class=&quot;vM0jzc&quot;&gt;&lt;span data-huuid=&quot;7341921977374771961&quot;&gt;Uma coluna de &quot;Regiões&quot; com as categorias &quot;Norte&quot;, &quot;Nordeste&quot;, &quot;Centro-Oeste&quot;, &quot;Sudeste&quot; e &quot;Sul&quot; pode ser transformada em &quot;0&quot;, &quot;1&quot;, &quot;2&quot;, &quot;3&quot; e &quot;4&quot;, respectivamente.&lt;span data-cid=&quot;aa02334d-09c9-4983-8c33-865ad78d7b6a&quot; class=&quot;pjBG2e&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot; class=&quot;UV3uM&quot;&gt;&amp;nbsp;&lt;div style=&quot;margin-inline-end: 6px; vertical-align: middle; display: inline-flex;&quot; data-uuids=&quot;7341921977374772514,7341921977374771961&quot; data-cid=&quot;aa02334d-09c9-4983-8c33-865ad78d7b6a&quot; class=&quot;NPrrbc&quot;&gt;&lt;div style=&quot;display: inline-block; vertical-align: middle; cursor: pointer; outline: 0px; -webkit-tap-highlight-color: transparent; color: rgb(11, 87, 208);&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQ3fYKegQIFxAB&quot; data-hveid=&quot;CBcQAQ&quot; tabindex=&quot;0&quot; role=&quot;button&quot; aria-label=&quot;Mostrar links relacionados&quot; class=&quot;BMebGe btku5b LwdV0e FR7ZSc OJeuxf&quot;&gt;&lt;div style=&quot;display: flex; justify-content: center; position: relative; align-items: center; width: 28px; z-index: 0; box-sizing: border-box; border-radius: 9999px; padding: 0px; background: transparent; outline: transparent solid 1px; outline-offset: -1px; height: 20px; margin: 0px auto; min-height: 20px;&quot; class=&quot;niO4u&quot;&gt;&lt;span style=&quot;flex-shrink: 0; display: flex; align-items: center; height: 20px; color: rgb(31, 31, 31); background: unset !important;&quot; class=&quot;d3o3Ad Hkv2Pe&quot;&gt;&lt;span style=&quot;display: flex; height: unset; rotate: 135deg;&quot; class=&quot;iPjmzb Sorfoc gNGSDf&quot;&gt;&lt;span style=&quot;display: inline-block; fill: currentcolor; height: 18px; line-height: 18px; position: relative; width: 18px;&quot; class=&quot;z1asCe Sb7k4e&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;li style=&quot;margin: 0px; padding-top: 0px; padding-bottom: 0px; padding-inline-start: 4px; list-style: inherit;&quot;&gt;&lt;div style=&quot;padding-bottom: 0px; padding-top: 8px; border-bottom: none;&quot; data-il=&quot;&quot; class=&quot;zMgcWd dSKvsb&quot;&gt;&lt;div data-crb-p=&quot;&quot;&gt;&lt;div style=&quot;flex: 1 1 0%; min-width: 0px;&quot; class=&quot;xFTqob&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;div style=&quot;line-height: 24px; overflow: hidden; padding-bottom: 4px; transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); display: inline;&quot; class=&quot;Gur8Ad&quot;&gt;&lt;span data-huuid=&quot;7341921977374770855&quot;&gt;&lt;strong&gt;Utilização:&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10); line-height: 24px; display: inline;&quot; class=&quot;vM0jzc&quot;&gt;&lt;span data-huuid=&quot;7341921977374770302&quot;&gt;O resultado é um conjunto de dados numéricos que pode ser processado por algoritmos de machine learning.&lt;span data-cid=&quot;27334687-f1f8-4613-9215-3b4a9fa6c58e&quot; class=&quot;pjBG2e&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot; class=&quot;UV3uM&quot;&gt;&amp;nbsp;&lt;div style=&quot;margin-inline-end: 6px; vertical-align: middle; display: inline-flex;&quot; data-uuids=&quot;7341921977374770855,7341921977374770302&quot; data-cid=&quot;27334687-f1f8-4613-9215-3b4a9fa6c58e&quot; class=&quot;NPrrbc&quot;&gt;&lt;div style=&quot;display: inline-block; vertical-align: middle; cursor: pointer; outline: 0px; -webkit-tap-highlight-color: transparent; color: rgb(11, 87, 208);&quot; data-ved=