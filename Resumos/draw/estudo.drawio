                <mxCell id="55" value="&lt;font style=&quot;font-size: 48px;&quot;&gt;Links de referencia para estudo:&lt;/font&gt;" style="text;strokeColor=none;fillColor=none;html=1;fontSize=24;fontStyle=1;verticalAlign=middle;align=center;" parent="1" vertex="1">
