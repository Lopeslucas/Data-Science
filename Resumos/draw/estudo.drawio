                    <mxGeometry x="2090" y="10" width="200" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="71" value="&lt;font face=&quot;Helvetica&quot;&gt;Q&lt;font&gt;uartis são&amp;nbsp;&lt;mark style=&quot;color: rgb(0, 29, 53); border-radius: 4px; background: none 0% 0% / auto repeat scroll padding-box border-box rgb(211, 227, 253); padding: 0px 2px;&quot; class=&quot;HxTRcb&quot;&gt;medidas estatísticas que dividem um conjunto de dados ordenados em quatro partes iguais, cada uma representando 25% da amostra&lt;/mark&gt;&lt;span style=&quot;color: rgb(10, 10, 10);&quot;&gt;. Os três quartis (Q1, Q2, Q3) delimitam os dados: Q1 (25º percentil) separa os 25% menores valores, Q2 (mediana) separa os 50% inferiores, e Q3 (75º percentil) separa os 75% inferiores.&lt;/span&gt;&lt;span style=&quot;color: rgb(10, 10, 10);&quot; data-wiz-uids=&quot;qEWR6b_c,qEWR6b_d&quot; class=&quot;uJ19be notranslate&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap; position: relative;&quot; data-wiz-attrbind=&quot;class=qEWR6b_b/TKHnVd&quot; data-animation-atomic=&quot;&quot; class=&quot;vKEkVd&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/font&gt;&lt;div&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span style=&quot;color: rgb(10, 10, 10);&quot; data-wiz-uids=&quot;qEWR6b_c,qEWR6b_d&quot; class=&quot;uJ19be notranslate&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap; position: relative;&quot; data-wiz-attrbind=&quot;class=qEWR6b_b/TKHnVd&quot; data-animation-atomic=&quot;&quot; class=&quot;vKEkVd&quot;&gt;&lt;span aria-hidden=&quot;true&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;div style=&quot;font-family: &amp;quot;Google Sans&amp;quot;, Arial, sans-serif; line-height: 24px; overflow-wrap: break-word; margin-block: 12px 16px; color: rgb(10, 10, 10); margin-inline: 0px;&quot; data-processed=&quot;true&quot; data-hveid=&quot;CAMQAA&quot; data-sfc-cp=&quot;&quot; class=&quot;Y3BBE&quot;&gt;&lt;font style=&quot;font-size: 30px;&qu