xUpBLkGHYO-OPkQo_EKegQIIxAB&quot; data-hveid=&quot;CCMQAQ&quot; class=&quot;rPeykc uP58nb rWIipd&quot;&gt;&lt;span data-huuid=&quot;14383098360763218950&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Onde usar&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10);&quot; class=&quot;WaaZC&quot;&gt;&lt;div style=&quot;color: rgb(10, 10, 10); animation: auto ease 0s 1 normal none running none !important;&quot; class=&quot;RJPOee EIJn2&quot;&gt;&lt;ul style=&quot;margin: 10px 0px 20px; padding: 0px; line-height: 24px; padding-inline-start: 16px;&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQm_YKegQIJBAB&quot; data-hveid=&quot;CCQQAQ&quot;&gt;&lt;li style=&quot;margin: 0px; padding-top: 0px; padding-bottom: 0px; padding-inline-start: 4px; list-style: inherit;&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;span data-huuid=&quot;14383098360763219823&quot;&gt;&lt;strong&gt;Dados ordinais:&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;span data-huuid=&quot;14383098360763216018&quot;&gt;A técnica é especialmente útil para dados categóricos que têm uma ordem inerente, como tamanhos de roupa (P, M, G) ou níveis de escolaridade.&lt;span data-cid=&quot;77352724-78a6-40b5-a083-281170910676&quot; class=&quot;pjBG2e&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot; class=&quot;UV3uM&quot;&gt;&amp;nbsp;&lt;div style=&quot;margin-inline-end: 6px; vertical-align: middle; display: inline-flex;&quot; data-uuids=&quot;14383098360763219823,14383098360763216018&quot; data-cid=&quot;77352724-78a6-40b5-a083-281170910676&quot; class=&quot;NPrrbc&quot;&gt;&lt;div style=&quot;display: inline-block; vertical-align: middle; cursor: pointer; outline: 0px; -webkit-tap-highlight-color: transparent; color: rgb(11, 87, 208);&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQ3fYKegQIKBAB&quot; data-hveid=&quot;CCgQAQ&quot; tabindex=&quot;0&quot; role=&quot;button&quot; aria-label=&quot;Mostrar links relacionados&quot; class=&quot;BMebGe btku5b LwdV0e FR7ZSc OJeuxf&quot;&gt;&lt;div style=&quot;display: flex; justify-content: center; position: relative; align-items: center; width: 28px; z-index: 0; box-sizing: border-box; border-radius: 9999px; padding: 0px; background: transparent; outline: transparent solid 1px; outline-offset: -1px; height: 20px; margin: 0px auto; min-height: 20px;&quot; class=&quot;niO4u&quot;&gt;&lt;span style=&quot;flex-shrink: 0; display: flex; align-items: center; height: 20px; color: rgb(31, 31, 31); background: unset !important;&quot; class=&quot;d3o3Ad Hkv2Pe&quot;&gt;&lt;span style=&quot;display: flex; height: unset; rotate: 135deg;&quot; class=&quot;iPjmzb Sorfoc gNGSDf&quot;&gt;&lt;span style=&quot;display: inline-block; fill: currentcolor; height: 18px; line-height: 18px; position: relative; width: 18px;&quot; class=&quot;z1asCe Sb7k4e&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10);&quot; class=&quot;WaaZC&quot;&gt;&lt;div style=&quot;color: rgb(10, 10, 10); animation: auto ease 0s 1 normal none running none !important;&quot; class=&quot;RJPOee EIJn2&quot;&gt;&lt;div style=&quot;margin: 20px 0px 10px; font-weight: 600; line-height: 28px;&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQo_EKegQILhAB&quot; data-hveid=&quot;CC4QAQ&quot; class=&quot;rPeykc uP58nb rWIipd&quot;&gt;&lt;span data-huuid=&quot;18074277471472600835&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;Considerações importantes&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10);&quot; class=&quot;WaaZC&quot;&gt;&lt;div style=&quot;color: rgb(10, 10, 10); animation: auto ease 0s 1 normal none running none !important;&quot; class=&quot;RJPOee EIJn2&quot;&gt;&lt;ul style=&quot;margin: 10px 0px 20px; padding: 0px; line-height: 24px; padding-inline-start: 16px;&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQm_YKegQIORAB&quot; data-hveid=&quot;CDkQAQ&quot;&gt;&lt;li style=&quot;margin: 0px 0px 8px; padding-top: 0px; padding-bottom: 0px; padding-inline-start: 4px; list-style: inherit;&quot;&gt;&lt;div style=&quot;padding-bottom: 0px; padding-top: 0px; border-bottom: none;&quot; data-il=&quot;&quot; class=&quot;zMgcWd dSKvsb&quot;&gt;&lt;div data-crb-p=&quot;&quot;&gt;&lt;div style=&quot;flex: 1 1 0%; min-width: 0px;&quot; class=&quot;xFTqob&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;div style=&quot;line-height: 24px; overflow: hidden; padding-bottom: 4px; transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); display: inline;&quot; class=&quot;Gur8Ad&quot;&gt;&lt;span data-huuid=&quot;18074277471472599572&quot;&gt;&lt;strong&gt;Cuidado com dados nominais:&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10); line-height: 24px; display: inline;&quot; class=&quot;vM0jzc&quot;&gt;&lt;span data-huuid=&quot;18074277471472599151&quot;&gt;O Label Encoding não é adequado para dados nominais (onde não há relação de ordem), como &quot;cores&quot;, pois a atribuição de números pode criar uma ordem artificial e prejudicar o modelo.&amp;nbsp;&lt;/span&gt;&lt;span data-huuid=&quot;18074277471472602826&quot;&gt;Nesses casos, outras técnicas como a codificação&amp;nbsp;&lt;a style=&quot;text-decoration-thickness: 8%; text-decoration-style: dotted; text-decoration-color: rgb(94, 94, 94); -webkit-tap-highlight-color: rgba(0, 0, 0, 0.1); text-underline-offset: 10%; text-decoration-skip-ink: auto; outline: 0px;&quot; data-hveid=&quot;CDQQAQ&quot; href=&quot;https://www.google.com/search?rlz=1C5CHFA_enBR1167BR1167&amp;amp;cs=0&amp;amp;sca_esv=30cc307e8b6ba113&amp;amp;sxsrf=AE3TifPUyWTjhFjP1amX5hR4SC_PssmUHA%3A1761430888011&amp;amp;q=One-Hot+Encoding&amp;amp;sa=X&amp;amp;ved=2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQxccNegQINBAB&amp;amp;mstk=AUtExfB-KcRrY9ACgUMi6qiNRrUqU7-fbeei_fdVY-aO_9XCJUg3YqslzFVjuvGM-SL9YqjoJP0H3BVnLfl6pwTDRz3NFBqIRX4S0cOTzDfUpkHOieKw8b7Yu8HetJraatGgcKt63K63qhMDZDwdvNXGuHX9EZplvHh0Qar1MxdKeNX6aMI&amp;amp;csui=3&quot; class=&quot;DTlJ6d&quot;&gt;One-Hot Encoding&lt;/a&gt;&amp;nbsp;podem ser mais apropriadas.&lt;span data-cid=&quot;6f93148c-5474-48ce-a621-9a1fb19f63f6&quot; class=&quot;pjBG2e&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot; class=&quot;UV3uM&quot;&gt;&amp;nbsp;&lt;div style=&quot;margin-inline-end: 6px; vertical-align: middle; display: inline-flex;&quot; data-uuids=&quot;18074277471472599572,18074277471472599151,18074277471472602826&quot; data-cid=&quot;6f93148c-5474-48ce-a621-9a1fb19f63f6&quot; class=&quot;NPrrbc&quot;&gt;&lt;div style=&quot;display: inline-block; vertical-align: middle; cursor: pointer; outline: 0px; -webkit-tap-highlight-color: transparent; color: rgb(11, 87, 208);&quot; data-ved=&quot;2ahUKEwj7iuOyscCQAxUpBLkGHYO-OPkQ3fYKegQINBAC&quot; data-hveid=&quot;CDQQAg&quot; tabindex=&quot;0&quot; role=&quot;button&quot; aria-label=&quot;Mostrar links relacionados&quot; class=&quot;BMebGe btku5b LwdV0e FR7ZSc OJeuxf&quot;&gt;&lt;div style=&quot;display: flex; justify-content: center; position: relative; align-items: center; width: 28px; z-index: 0; box-sizing: border-box; border-radius: 9999px; padding: 0px; background: transparent; outline: transparent solid 1px; outline-offset: -1px; height: 20px; margin: 0px auto; min-height: 20px;&quot; class=&quot;niO4u&quot;&gt;&lt;span style=&quot;flex-shrink: 0; display: flex; align-items: center; height: 20px; color: rgb(31, 31, 31); background: unset !important;&quot; class=&quot;d3o3Ad Hkv2Pe&quot;&gt;&lt;span style=&quot;display: flex; height: unset; rotate: 135deg;&quot; class=&quot;iPjmzb Sorfoc gNGSDf&quot;&gt;&lt;span style=&quot;display: inline-block; fill: currentcolor; height: 18px; line-height: 18px; position: relative; width: 18px;&quot; class=&quot;z1asCe Sb7k4e&quot;&gt;&lt;svg viewBox=&quot;0 0 24 24&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot; aria-hidden=&quot;true&quot;&gt;&lt;path d=&quot;M3.9 12c0-1.71 1.39-3.1 3.1-3.1h4V7H7c-2.76 0-5 2.24-5 5s2.24 5 5 5h4v-1.9H7c-1.71 0-3.1-1.39-3.1-3.1zM8 13h8v-2H8v2zm9-6h-4v1.9h4c1.71 0 3.1 1.39 3.1 3.1s-1.39 3.1-3.1 3.1h-4V17h4c2.76 0 5-2.24 5-5s-2.24-5-5-5z&quot;&gt;&lt;/path&gt;&lt;/svg&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;li style=&quot;margin: 0px; padding-top: 0px; padding-bottom: 0px; padding-inline-start: 4px; list-style: inherit;&quot;&gt;&lt;div style=&quot;padding-bottom: 0px; padding-top: 8px; border-bottom: none;&quot; data-il=&quot;&quot; class=&quot;zMgcWd dSKvsb&quot;&gt;&lt;div data-crb-p=&quot;&quot;&gt;&lt;div style=&quot;flex: 1 1 0%; min-width: 0px;&quot; class=&quot;xFTqob&quot;&gt;&lt;font face=&quot;Helvetica&quot;&gt;&lt;div style=&quot;line-height: 24px; overflow: hidden; padding-bottom: 4px; transition: transform 200ms cubic-bezier(0.2, 0, 0, 1); display: inline;&quot; class=&quot;Gur8Ad&quot;&gt;&lt;span data-huuid=&quot;18074277471472601984&quot;&gt;&lt;strong&gt;Uso para alvos:&lt;/strong&gt;&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(10, 10, 10); line-height: 24px; display: inline;&quot; class=&quot;vM0jzc&quot;&gt;&lt;span data-huuid=&quot;18074277471472601563&quot;&gt;É recomendado usar o Label Encoding principalmente para a variável alvo (y) e não para as variáveis de entrada (X), conforme recomendado pelo Scikit-learn.&lt;span data-cid=&quot;2e63a460-680b-4433-b3e8-287c0d2e51b2&quot; class=&quot;pjBG2e&quot;&gt;&lt;span style=&quot;text-wrap-mode: nowrap;&quot; class=&quot;UV3uM&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/div&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;/div&gt;&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;&lt;/div&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;One-Hot Encoding:&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;font-size: 18px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;Ordinal Encoding:&lt;/font&gt;&lt;/b&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=14;" parent="1" vertex="1">
                    <mxGeometry x="7830" y="1620" width="1020" height="930" as="geometry"/>
                </mxCell>
                <mxCell id="54" value="" style="line;strokeWidth=2;direction=south;html=1;" parent="1" vertex="1">
                    <mxGeometry x="-1130" width="10" height="1490" as="geometry"/>
                </mxCell>
                <mxCell id="63" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;Bias e Variance&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;b style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251);&quot;&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;Bias (ou viés em português)&lt;/font&gt;&lt;/b&gt;&lt;/h1&gt;&lt;p&gt;é o erro devido à diferença entre as previsões médias e os valores corretos que estamos tentando prever, quando treinamos um modelo, geralmente repetimos o processo de treinamento n vezes e cada vez que o modelo é treinado, um novo modelo é criado e pela aleatoriedade dos dados, consequentemente teremos uma variedade de previsões, então o Bias ou Viés é a distância, em geral, das previsões para o valor correto.&amp;nbsp;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;font-size: 30px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Variance (ou variância em português)&lt;/b&gt;:&amp;nbsp;&lt;/font&gt;&lt;/p&gt;&lt;p&gt;é o erro devido à variabilidade de uma previsão do modelo para um determinado ponto de dados. Repetindo novamente o treinamento, a variância mede o quanto as previsões do modelo variam entre diferentes realizações do modelo.&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=22;" parent="1" vertex="1">
                    <mxGeometry x="1000" y="980" width="970" height="470" as="geometry"/>
                </mxCell>
                <mxCell id="64" value="&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; line-height: 1.5rem; margin-block-end: 0.75rem;&quot; data-start-index=&quot;989&quot; class=&quot;paragraph normal ng-star-inserted&quot;&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;• &lt;/span&gt;&lt;b class=&quot;ng-star-inserted&quot; data-start-index=&quot;989&quot;&gt;Baixa Dimensão (&lt;/b&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;&lt;span style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-size: 1.21em; line-height: 1.2; font-family: KaTeX_Main, &amp;quot;Times New Roman&amp;quot;, serif; text-rendering: auto;&quot; class=&quot;katex&quot;&gt;&lt;span style=&quot;border-color: currentcolor;&quot; aria-hidden=&quot;true&quot; class=&quot;katex-html&quot;&gt;&lt;span style=&quot;border-color: currentcolor; position: relative; white-space: nowrap; width: min-content; display: inline-block;&quot; class=&quot;base&quot;&gt;&lt;span style=&quot;border-color: currentcolor; display: inline-block; height: 0.5782em; vertical-align: -0.0391em;&quot; class=&quot;strut&quot;&gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; font-family: KaTeX_Math; font-style: italic;&quot; class=&quot;mord mathnormal&quot;&gt;n&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; display: inline-block; margin-right: 0.2778em;&quot; class=&quot;mspace&quot;&gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor;&quot; class=&quot;mrel&quot;&gt;&amp;gt;&amp;gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; display: inline-block; margin-right: 0.2778em;&quot; class=&quot;mspace&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; position: relative; white-space: nowrap; width: min-content; display: inline-block;&quot; class=&quot;base&quot;&gt;&lt;span style=&quot;border-color: currentcolor; display: inline-block; height: 0.625em; vertical-align: -0.1944em;&quot; class=&quot;strut&quot;&gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; font-family: KaTeX_Math; font-style: italic;&quot; class=&quot;mord mathnormal&quot;&gt;p&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;b class=&quot;ng-star-inserted&quot; data-start-index=&quot;1011&quot;&gt;):&lt;/b&gt;&lt;span class=&quot;ng-star-inserted&quot; data-start-index=&quot;1013&quot;&gt; Quando o número de observações é muito maior que o de variáveis, métodos clássicos como mínimos quadrados tendem a ter baixa variância e bom desempenho&lt;/span&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;&lt;button style=&quot;font: 500 11.008px / 16px &amp;quot;Google Sans Text&amp;quot;, &amp;quot;Google Sans&amp;quot;, sans-serif; letter-spacing: 0.096px; border-width: 0px; border-style: initial; border-color: initial; border-radius: 50%; height: 20px; margin-inline-start: 4px; min-width: 20px; cursor: pointer; background-color: rgb(237, 239, 250); color: rgb(27, 27, 28); transition: opacity 0.2s linear; opacity: 1; user-select: none;&quot; data-disabled=&quot;false&quot; aria-describedby=&quot;cdk-describedby-message-ng-1-17&quot; aria-haspopup=&quot;dialog&quot; class=&quot;xap-inline-dialog citation-marker ng-star-inserted&quot;&gt;&lt;/button&gt;&lt;/span&gt;&lt;span class=&quot;ng-star-inserted&quot; data-start-index=&quot;1165&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; line-height: 1.5rem; margin-block-end: 0.75rem;&quot; data-start-index=&quot;1166&quot; class=&quot;paragraph normal ng-star-inserted&quot;&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;• &lt;/span&gt;&lt;b class=&quot;ng-star-inserted&quot; data-start-index=&quot;1166&quot;&gt;Alta Dimensão (&lt;/b&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;&lt;span style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; font-size: 1.21em; line-height: 1.2; font-family: KaTeX_Main, &amp;quot;Times New Roman&amp;quot;, serif; text-rendering: auto;&quot; class=&quot;katex&quot;&gt;&lt;span style=&quot;border-color: currentcolor;&quot; aria-hidden=&quot;true&quot; class=&quot;katex-html&quot;&gt;&lt;span style=&quot;border-color: currentcolor; position: relative; white-space: nowrap; width: min-content; display: inline-block;&quot; class=&quot;base&quot;&gt;&lt;span style=&quot;border-color: currentcolor; display: inline-block; height: 0.7335em; vertical-align: -0.1944em;&quot; class=&quot;strut&quot;&gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; font-family: KaTeX_Math; font-style: italic;&quot; class=&quot;mord mathnormal&quot;&gt;p&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; display: inline-block; margin-right: 0.2778em;&quot; class=&quot;mspace&quot;&gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor;&quot; class=&quot;mrel&quot;&gt;&amp;gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; display: inline-block; margin-right: 0.2778em;&quot; class=&quot;mspace&quot;&gt;&lt;/span&gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; position: relative; white-space: nowrap; width: min-content; display: inline-block;&quot; class=&quot;base&quot;&gt;&lt;span style=&quot;border-color: currentcolor; display: inline-block; height: 0.4306em;&quot; class=&quot;strut&quot;&gt;&lt;/span&gt;&lt;span style=&quot;border-color: currentcolor; font-family: KaTeX_Math; font-style: italic;&quot; class=&quot;mord mathnormal&quot;&gt;n&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;/span&gt;&lt;b class=&quot;ng-star-inserted&quot; data-start-index=&quot;1186&quot;&gt;):&lt;/b&gt;&lt;span class=&quot;ng-star-inserted&quot; data-start-index=&quot;1188&quot;&gt; Quando você tem mais variáveis do que observações (como em dados genéticos com milhares de genes para poucos pacientes), o cenário é chamado de &lt;/span&gt;&lt;b class=&quot;ng-star-inserted&quot; data-start-index=&quot;1333&quot;&gt;high-dimensional&lt;/b&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;&lt;button style=&quot;font: 500 11.008px / 16px &amp;quot;Google Sans Text&amp;quot;, &amp;quot;Google Sans&amp;quot;, sans-serif; letter-spacing: 0.096px; border-width: 0px; border-style: initial; border-color: initial; border-radius: 50%; height: 20px; margin-inline-start: 4px; min-width: 20px; cursor: pointer; background-color: rgb(237, 239, 250); color: rgb(27, 27, 28); transition: opacity 0.2s linear; opacity: 1; user-select: none;&quot; data-disabled=&quot;false&quot; aria-describedby=&quot;cdk-describedby-message-ng-1-17&quot; aria-haspopup=&quot;dialog&quot; class=&quot;xap-inline-dialog citation-marker ng-star-inserted&quot;&gt;&lt;/button&gt;&lt;/span&gt;&lt;span class=&quot;ng-star-inserted&quot; data-start-index=&quot;1349&quot;&gt;.&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;font-variant-numeric: normal; font-variant-east-asian: normal; font-variant-alternates: normal; font-size-adjust: none; font-kerning: auto; font-optical-sizing: auto; font-feature-settings: normal; font-variation-settings: normal; font-variant-position: normal; font-variant-emoji: normal; font-stretch: normal; line-height: 1.5rem; margin-block-end: 0.75rem;&quot; data-start-index=&quot;1350&quot; class=&quot;paragraph normal ng-star-inserted&quot;&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;• &lt;/span&gt;&lt;b class=&quot;ng-star-inserted&quot; data-start-index=&quot;1350&quot;&gt;Riscos da Alta Dimensão:&lt;/b&gt;&lt;span class=&quot;ng-star-inserted&quot; data-start-index=&quot;1374&quot;&gt; Nesse caso, não é possível usar a regressão linear simples, pois ela causará &lt;/span&gt;&lt;b class=&quot;ng-star-inserted&quot; data-start-index=&quot;1452&quot;&gt;overfitting&lt;/b&gt;&lt;span class=&quot;ng-star-inserted&quot; data-start-index=&quot;1463&quot;&gt; (sobreajuste), resultando em um modelo que explica perfeitamente os dados de treino mas falha em prever novos dados&lt;/span&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;&lt;button style=&quot;font: 500 11.008px / 16px &amp;quot;Google Sans Text&amp;quot;, &amp;quot;Google Sans&amp;quot;, sans-serif; letter-spacing: 0.096px; border-width: 0px; border-style: initial; border-color: initial; border-radius: 50%; height: 20px; margin-inline-start: 4px; min-width: 20px; cursor: pointer; background-color: rgb(237, 239, 250); color: rgb(27, 27, 28); transition: opacity 0.2s linear; opacity: 1; user-select: none;&quot; data-disabled=&quot;false&quot; aria-describedby=&quot;cdk-describedby-message-ng-1-17&quot; aria-haspopup=&quot;dialog&quot; class=&quot;xap-inline-dialog citation-marker ng-star-inserted&quot;&gt;&lt;/button&gt;&lt;/span&gt;&lt;span class=&quot;ng-star-inserted&quot; data-start-index=&quot;1579&quot;&gt;,&lt;/span&gt;&lt;span class=&quot;ng-star-inserted&quot;&gt;&lt;button style=&quot;font: 500 11.008px / 16px &amp;quot;Google Sans Text&amp;quot;, &amp;quot;Google Sans&amp;quot;, sans-serif; letter-spacing: 