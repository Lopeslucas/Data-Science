                </mxCell>
                <mxCell id="26" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; font-size: 44px;&quot;&gt;Distribuição Gaussiana&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;color: rgb(63, 63, 63); background-color: transparent; font-size: 22px; font-weight: normal;&quot;&gt;Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.&lt;/span&gt;&lt;/h1&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=22;" vertex="1" parent="1">
                    <mxGeometry x="2960" y="-40" width="1230" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="27" value="&lt;span style=&quot;color: rgb(36, 36, 36); letter-spacing: -0.06px; text-align: start;&quot;&gt;O&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;box-sizing: inherit; font-weight: 700; color: rgb(36, 36, 36); letter-spacing: -0.06px; text-align: start;&quot; class=&quot;lq gn&quot;&gt;Método de Mínimos Quadrados&lt;/span&gt;&lt;span style=&quot;color: rgb(36, 36, 36); letter-spacing: -0.06px; text-align: start;&quot;&gt;&amp;nbsp;é muito utilizado para ajuste do modelo de regressão. O objetivo deste método é encontrar o melhor ajuste para um conjunto de dados através da minimização da soma dos quadrados das diferenças entre o valor estimado e os dados observados (valor real).&lt;/span&gt;" style="whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=21;" vertex="1" parent="1">
                    <mxGeometry x="1000" y="-690" width="1000" height="170" as="geometry"/>
